{
  "name": "@beremaran/opencode-goal",
  "version": "0.3.0",
  "description": "Persistent, evaluated /goal workflows for OpenCode",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Berke Arslan",
    "url": "https://github.com/beremaran"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beremaran/opencode-goal.git"
  },
  "bugs": {
    "url": "https://github.com/beremaran/opencode-goal/issues"
  },
  "homepage": "https://github.com/beremaran/opencode-goal#readme",
  "funding": "https://github.com/sponsors/beremaran",
  "sideEffects": false,
  "main": "./dist/server.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "import": "./dist/v2.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "opencode": ">=1.18.0"
  },
  "packageManager": "bun@1.2.23",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "test:coverage": "tsc -p tsconfig.test.json && node --test --experimental-test-coverage --test-coverage-include=.test-dist/src/** --test-coverage-lines=65 --test-coverage-branches=60 --test-coverage-functions=70 .test-dist/test/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:check": "npm pack --dry-run --ignore-scripts",
    "security:audit": "bun audit --audit-level=high",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run package:check",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "goal",
    "autonomous-agent",
    "ai-agent",
    "slash-command",
    "developer-tools"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.10",
    "zod": "^4.1.8"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.4.5",
    "@opentui/keymap": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentui/core": "^0.4.5",
    "@opentui/keymap": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "@types/node": "^24.1.0",
    "eslint": "^10.9.0",
    "prettier": "^3.6.2",
    "solid-js": "^1.9.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0"
  }
}
